#!/usr/bin/env bash
# Installs Nginx, adds a 301 redirect on /redirect_me and a custom 404 page
apt-get update
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/custom_404.html
sed -i '/server_name _;/a\\n\terror_page 404 /custom_404.html;\n\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-enabled/default
service nginx restart
