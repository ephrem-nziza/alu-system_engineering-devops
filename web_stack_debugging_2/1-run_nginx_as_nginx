#!/usr/bin/env bash
# Runs Nginx as the nginx user and listening on port 8080
pkill apache2
chmod 644 /etc/nginx/nginx.conf
sed -i 's/^#user www-data;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80 default_server/listen 8080 default_server/; s/\[::\]:80 default_server/[::]:8080 default_server/' /etc/nginx/sites-available/default
rm -f /run/nginx.pid
sudo -u nginx service nginx restart
